# ─── Supabase ────────────────────────────────────────────────────────
# Project URL — Supabase dashboard → Settings → API → Project URL
# (must be the bare project URL, NOT the REST endpoint with /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — SERVER ONLY. Used by /api/contact to insert submissions.
# Mark this as Sensitive in Vercel.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── SMTP (contact form notifications) ───────────────────────────────
# Optional — when configured, every contact form submission also sends an
# email to CONTACT_TO_EMAIL. If left blank, submissions are still saved to
# Supabase but no email goes out.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@nexusrealtymarketing.pk
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=Nexus Realty <noreply@nexusrealtymarketing.pk>
CONTACT_TO_EMAIL=info@nexusrealtymarketing.pk
# Optional override; defaults to true when port is 465
# SMTP_SECURE=true
